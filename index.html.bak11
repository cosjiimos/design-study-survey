<script>
function blankResponse(){
  return { cognitive:[], cognitivePrimary:null, awareness:null, intervention:null,
           authenticity:null, believability:null, experienced:null, awkward:'',
           plausibility:null, faithfulness:null,
           confidence:null, infoSufficiency:null,
           trajFlow:null, trajConsistency:null, trajText:'' };
}
new Vue({
  el:'#app',
  data:{
    // ===== deployment config =====
    webhookUrl: 'https://script.google.com/macros/s/AKfycbwdp43pr0ax2T_wuUN0gstwYQ9QCkokcNyqhHAfVzjo6Is1kQhfTyuDi6B_bobp2R1l2w/exec',
    showAdmin:false, adminDomain:'Interior Design', adminLog:'', autoTesting:false,
    participantId:'', studyId:'', sessionId:'',
    experience:'', participantDomain:'', consent:false,
    availableDomains:[
      'UI/UX Design','Product Design','Graphic Design','Web Design','Industrial Design',
      'Architecture','Interior Design','Fashion Design','Brand Design','Motion Graphics'
    ],

    stage:'intro',          // intro | cognitive | survey | complete
    startTime:null,
    submitState:'idle',
    phaseWarning:'',

    allProjects: (typeof v7Projects!=='undefined') ? v7Projects : [],
    domainProjects:[],
    projectIndex:0, phaseIndex:0, qIndex:0,
    responses:{},           // keyed "proj-phase" -> response object

    // typewriter
    shown:'', typing:false, _timer:null,

    // ===== survey option sets =====
    cognitiveOptions:[
      {key:'Ambiguity',  label:'Ambiguity',       desc:'Multiple valid interpretations (discrete options)'},
      {key:'Vagueness',  label:'Vagueness',       desc:'Unclear / fuzzy boundaries (a matter of degree)'},
      {key:'Uncertainty',label:'Uncertainty',     desc:'Insufficient information / data'},
      {key:'Tacit',      label:'Tacit Knowledge', desc:'Intuitive, hard-to-articulate; acts on feel'},
      {key:'None',       label:'No clear block',  desc:'No indeterminacy in this phase'}
    ],
    primaryOptions:[
      {key:'Ambiguity',label:'Ambiguity'},{key:'Vagueness',label:'Vagueness'},{key:'Uncertainty',label:'Uncertainty'},
      {key:'Tacit',label:'Tacit Knowledge'},{key:'Mixed',label:'Mixed (several, roughly equal)'},{key:'None',label:'No clear block'}
    ],
    awarenessOptions:[
      {key:'aware',   label:'Clearly aware',   desc:'Names / recognizes what they are stuck on'},
      {key:'partial', label:'Partially aware', desc:'Senses something is off, not fully'},
      {key:'unaware', label:'Barely aware',    desc:'Acts on intuition; cannot articulate why'}
    ],
    interventionOptions:[
      {key:'options', label:'Present concrete options',      desc:'Lay out distinct alternatives to choose from'},
      {key:'range',   label:'Set a range / criteria',        desc:'Help fix a threshold or boundary'},
      {key:'info',    label:'Provide information / grounds',  desc:'Supply data to raise confidence'},
      {key:'example', label:'Show examples / co-create',      desc:'Demonstrate or build together'}
    ],
    baseQuestions:[
      {group:'A · Diagnose the block', type:'check', key:'cognitive',
        text:'What kind of block (indeterminacy) is present? Select all that apply.', hint:'Judge only from what you saw — no label is shown to you.'},
      {group:'A · Diagnose the block', type:'single', key:'cognitivePrimary', opts:'primaryOptions',
        text:'Which one is most prominent?', hint:'Pick the single dominant block (or Mixed / None).'},
      {group:'A · Diagnose the block', type:'single', key:'awareness', opts:'awarenessOptions',
        text:'How aware was the designer of what they were stuck on?', hint:'Awareness of the block.'},
      {group:'A · Diagnose the block', type:'single', key:'intervention', opts:'interventionOptions',
        text:'What would have helped most at this moment?', hint:'The most fitting kind of support.'},
      {group:'B · Believability', type:'rating', key:'authenticity',
        text:'How authentic does this phase feel?', hint:"Does it read like a real designer's process for this domain?", lo:'Not authentic', hi:'Very authentic'},
      {group:'B · Believability', type:'rating', key:'believability',
        text:'Could you believe an actual designer produced this?', hint:'Believability of this phase.', lo:'Not believable', hi:'Very believable'},
      {group:'B · Believability', type:'rating', key:'experienced',
        text:'Have you run into a situation like this in your own practice?', hint:'Personal familiarity.', lo:'Never', hi:'Often'},
      {group:'B · Believability', type:'text', key:'awkward',
        text:'Anything that felt off or not real? (optional)', hint:'Name the moment that broke it, if any.', ph:'e.g. the jump from X to Y felt unmotivated…'},
      {group:'C · Process Quality', type:'rating', key:'plausibility',
        text:'Is this a plausible way to proceed in this domain?', hint:'Matches real practice.', lo:'Implausible', hi:'Highly plausible'},
      {group:'C · Process Quality', type:'rating', key:'faithfulness',
        text:'Is each move grounded in the brief and earlier phases?', hint:'No fabricated or unsupported moves.', lo:'Ungrounded', hi:'Well grounded'},
      {group:'D · Your Confidence', type:'rating', key:'confidence',
        text:'How confident are you in your judgments for this phase?', hint:'Overall confidence.', lo:'Not confident', hi:'Very confident'},
      {group:'D · Your Confidence', type:'rating', key:'infoSufficiency',
        text:'Was there enough information to judge this phase?', hint:'Information sufficiency.', lo:'Not enough', hi:'More than enough'}
    ],
    trajectoryQuestions:[
      {group:'E · Whole project', type:'rating', key:'trajFlow',
        text:'Does the flow of blocks and resolutions unfold like a real project?', hint:'Shown once, at the end of the project.', lo:'Unnatural', hi:'Very natural'},
      {group:'E · Whole project', type:'rating', key:'trajConsistency',
        text:'Is the designer coherent as one person across phases?', hint:'Character consistency.', lo:'Inconsistent', hi:'Very consistent'},
      {group:'E · Whole project', type:'text', key:'trajText',
        text:'Most unrealistic part of the whole process? (optional)', hint:'', ph:'Optional…'}
    ]
  },
  computed:{
    canStart(){ return this.experience && this.participantDomain && this.consent; },
    selectedProject(){ return this.domainProjects[this.projectIndex] || null; },
    phases(){ return this.selectedProject ? this.selectedProject.phases : []; },
    phase(){ return this.phases[this.phaseIndex] || {}; },
    dp(){ return (this.selectedProject && this.selectedProject.designer_profile) || {}; },
    brief(){ return (this.selectedProject && this.selectedProject.project_brief) || null; },
    respKey(){ return this.projectIndex + '-' + this.phaseIndex; },
    R(){
      if(!this.responses[this.respKey]) this.$set(this.responses, this.respKey, blankResponse());
      return this.responses[this.respKey];
    },
    fullText(){ const p=this.phase; return p.ultra_realistic_think_aloud || (p.think_aloud && p.think_aloud.utterance) || '…'; },
    deliverables(){ const p=this.phase; return (p.phase_outcome && p.phase_outcome.deliverables_produced) || p.deliverables || []; },
    pct(){ return this.phases.length ? Math.round(((this.phaseIndex+1)/this.phases.length)*100) : 0; },
    totalPhaseCount(){ return this.domainProjects.reduce((s,p)=>s+p.phases.length,0); },
    answeredCount(){
      var n=0, self=this;
      Object.keys(this.responses).forEach(function(k){ if(self.isRespAnswered(self.responses[k])) n++; });
      return n;
    },
    overallProgress(){ return this.totalPhaseCount ? Math.round((this.answeredCount/this.totalPhaseCount)*100) : 0; },
    cogHex(){ return '#6d5efc'; },
    accentHex(){ return '#6d5efc'; },
    persona(){ return (this.dp.personality_type||'The Designer').toLowerCase(); },
    skin(){
      var palettes=[
        {face:'#f0c9a8',hair:'#3b2a20',shirt:'#8fb3d9',shirtDark:'#5f86b0',desk:'#e7dccb',deskTop:'#d6c7b0',line:'#8a6a52'},
        {face:'#e8b48c',hair:'#22201f',shirt:'#a6d0a0',shirtDark:'#6fae78',desk:'#e7dccb',deskTop:'#d6c7b0',line:'#7a5540'},
        {face:'#f3d3b3',hair:'#6b3f2a',shirt:'#e0a0a8',shirtDark:'#c07079',desk:'#e7dccb',deskTop:'#d6c7b0',line:'#8a6a52'},
        {face:'#d9a679',hair:'#111',shirt:'#c9b6f0',shirtDark:'#9a80d6',desk:'#e7dccb',deskTop:'#d6c7b0',line:'#6e4a33'}
      ];
      var n=(this.dp.name||'D'); var h=0; for(var i=0;i<n.length;i++) h=(h*31+n.charCodeAt(i))>>>0;
      return palettes[h % palettes.length];
    },
    accessory(){ var t=this.persona;
      if(t.indexOf('research')>-1||t.indexOf('perfection')>-1) return 'glasses';
      if(t.indexOf('art')>-1||t.indexOf('crea')>-1) return 'beret'; return 'none'; },
    mouthPath(){ return 'M120 137 Q130 140 140 137'; },
    questions(){ var last=this.phaseIndex===this.phases.length-1;
      return last ? this.baseQuestions.concat(this.trajectoryQuestions) : this.baseQuestions; },
    safeReqs(){ var re=/ambig|vague|uncertain|tacit|fuzzy|unclear|intuiti|contradict|indetermin|interpretation/i;
      return (this.phase.requirements||[]).filter(function(r){ return !re.test(String(r)); }); },
    curQ(){ return this.questions[this.qIndex]; },
    nextLabel(){
      if(this.qIndex < this.questions.length-1) return 'Next question →';
      var lastPhase = this.phaseIndex === this.phases.length-1;
      var lastProj  = this.projectIndex === this.domainProjects.length-1;
      if(lastPhase && lastProj) return 'Finish & Submit';
      if(lastPhase) return 'Next project →';
      return 'Next phase →';
    },
    completionCode(){
      var codes={
        'UI/UX Design':'UIUX2024DES','Product Design':'PROD2024DES','Graphic Design':'GRAF2024DES',
        'Web Design':'WEBD2024DES','Industrial Design':'INDU2024DES','Architecture':'ARCH2024DES',
        'Interior Design':'INTE2024DES','Fashion Design':'FASH2024DES','Brand Design':'BRAN2024DES',
        'Motion Graphics':'MOTI2024DES'
      };
      return codes[this.participantDomain] || 'DESIGN2024';
    },
    timeSpent(){ if(!this.startTime) return '0 min';
      return Math.max(1, Math.round((Date.now()-this.startTime)/60000)) + ' min'; }
  },
  methods:{
    // ---- required-answer check for a response object (text/optional fields excluded) ----
    isRespAnswered(r){
      if(!r) return false;
      return r.cognitive.length>0 && r.cognitivePrimary!=null && r.awareness!=null && r.intervention!=null
        && r.authenticity!=null && r.believability!=null && r.experienced!=null
        && r.plausibility!=null && r.faithfulness!=null
        && r.confidence!=null && r.infoSufficiency!=null;
    },
    optsFor(q){ return this[q.opts] || []; },
    setSingle(key,val){ this.$set(this.R, key, val); },
    setRating(key,n){ this.$set(this.R, key, n); },
    isQAnswered(i){
      var q=this.questions[i];
      if(q.type==='check') return this.R.cognitive.length>0;
      if(q.type==='text')  return true; // optional
      return this.R[q.key]!==null && this.R[q.key]!==undefined;
    },
    // ---- intro flow ----
    goToCognitiveIntro(){ if(this.canStart) this.stage='cognitive'; },
    startSurvey(){
      this.startTime = Date.now();
      this.domainProjects = this.allProjects.filter(function(p){ return p.domain === this.participantDomain; }.bind(this));
      this.responses = {};
      this.projectIndex=0; this.phaseIndex=0; this.qIndex=0;
      this.stage='survey';
      this.retype();
      window.scrollTo(0,0);
    },
    // ---- survey navigation ----
    prevQ(){ if(this.qIndex>0){ this.qIndex--; this.phaseWarning=''; } },
    nextQ(){
      // require current question answered (text is optional)
      if(!this.isQAnswered(this.qIndex)){ this.phaseWarning='Please answer this question before continuing.'; return; }
      this.phaseWarning='';
      if(this.qIndex < this.questions.length-1){ this.qIndex++; return; }
      // last question of phase -> advance
      this.advancePhase();
    },
    advancePhase(){
      var lastPhase = this.phaseIndex === this.phases.length-1;
      var lastProj  = this.projectIndex === this.domainProjects.length-1;
      if(!lastPhase){ this.phaseIndex++; this.qIndex=0; this.retype(); window.scrollTo(0,0); return; }
      if(!lastProj){ this.projectIndex++; this.phaseIndex=0; this.qIndex=0; this.retype(); window.scrollTo(0,0); return; }
      this.submitSurvey();
    },
    prev(){
      if(this.qIndex>0){ this.qIndex--; return; }
      if(this.phaseIndex>0){ this.phaseIndex--; this.qIndex=0; this.retype(); window.scrollTo(0,0); return; }
      if(this.projectIndex>0){ this.projectIndex--; this.phaseIndex=this.phases.length-1; this.qIndex=0; this.retype(); window.scrollTo(0,0); }
    },
    retype(){
      clearInterval(this._timer); this.shown=''; this.typing=true;
      var txt=this.fullText; var i=0; var self=this;
      var step=Math.max(12, Math.min(28, Math.round(txt.length/48)));
      this._timer=setInterval(function(){ i+=step; self.shown=txt.slice(0,i);
        if(i>=txt.length){ self.shown=txt; self.typing=false; clearInterval(self._timer); } },22);
    },
    // ---- submit ----
    submitSurvey(){
      this.stage='complete'; this.submitState='sending';
      var self=this;
      var payload={
        participantId:this.participantId, studyId:this.studyId, sessionId:this.sessionId,
        experience:this.experience, domain:this.participantDomain,
        startTime:this.startTime, endTime:Date.now(),
        durationSeconds:Math.round((Date.now()-this.startTime)/1000),
        completionCode:this.completionCode,
        projects:this.domainProjects.map(function(p,pi){
          return {
            projectId:p.project_id, projectName:p.project_name,
            designer:(p.designer_profile&&p.designer_profile.name)||'',
            phases:p.phases.map(function(ph,hi){
              var r=self.responses[pi+'-'+hi] || blankResponse();
              return {
                phaseNumber:ph.phase_number, phaseName:ph.phase_name,
                actualCognitiveState:ph.cognitive_state,
                identifiedStates:r.cognitive, primaryState:r.cognitivePrimary,
                awareness:r.awareness, intervention:r.intervention,
                authenticity:r.authenticity, believability:r.believability, experienced:r.experienced,
                awkward:r.awkward, plausibility:r.plausibility, faithfulness:r.faithfulness,
                confidence:r.confidence, infoSufficiency:r.infoSufficiency,
                trajFlow:r.trajFlow, trajConsistency:r.trajConsistency, trajText:r.trajText
              };
            })
          };
        })
      };
      if(this.webhookUrl && this.webhookUrl!=='YOUR_GOOGLE_SHEETS_WEBHOOK_URL'){
        fetch(this.webhookUrl, {method:'POST', mode:'no-cors', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)})
          .then(function(){ self.submitState='done'; })
          .catch(function(e){ console.error('submit error', e); self.submitState='error'; });
      } else {
        this.submitState='done'; console.log('No webhook. Payload:', payload);
      }
    },
    // ---- url params / admin ----
    captureUrlParams(){
      var q=new URLSearchParams(window.location.search);
      this.participantId = q.get('PROLIFIC_PID') || q.get('participant_id') || '';
      this.studyId = q.get('STUDY_ID') || q.get('study_id') || '';
      this.sessionId = q.get('SESSION_ID') || q.get('session_id') || '';
      var d=q.get('domain');
      if(d && this.availableDomains.indexOf(d)>-1) this.participantDomain=d;
      if(q.get('admin')==='1' || q.has('admin')) this.showAdmin=true;
    },
    pingWebhook(){
      if(!this.webhookUrl){ this.adminLog='No webhook URL set.'; return; }
      this.adminLog='Pinging webhook…'; var self=this;
      fetch(this.webhookUrl, {method:'POST', mode:'no-cors', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ping:true})})
        .then(function(){ self.adminLog='Ping sent (no-cors: opaque). Check the sheet for a "ping" row.'; })
        .catch(function(e){ self.adminLog='Ping failed: '+e.message; });
    },

    // ===== ADMIN: auto-run the whole survey with random answers =====
    runAutoTest(){
      if(this.autoTesting) return;
      var self=this;
      var rnd=function(n){ return 1+Math.floor(Math.random()*n); };
      var pick=function(arr){ return arr[Math.floor(Math.random()*arr.length)]; };
      // 1) fill intro + start
      this.participantId = this.participantId || ('TEST_'+Math.floor(Math.random()*1e6));
      this.experience = pick(['0-2','3-5','6-10','11-15','16+']);
      this.participantDomain = this.adminDomain;
      this.consent = true;
      this.autoTesting = true;
      this.goToCognitiveIntro();
      this.startSurvey();

      // fill the current phase's response object at random for every question type
      var fillPhase=function(){
        var R=self.R;
        self.questions.forEach(function(q){
          if(q.type==='rating'){ self.$set(R, q.key, rnd(7)); }
          else if(q.type==='single'){ var o=pick(self.optsFor(q)); if(o) self.$set(R, q.key, o.key); }
          else if(q.type==='text'){ self.$set(R, q.key, 'auto-test note'); }
          else if(q.type==='check'){
            var states=['Ambiguity','Vagueness','Uncertainty','Tacit'];
            var k=rnd(states.length);
            self.$set(R, 'cognitive', states.slice().sort(function(){return Math.random()-0.5;}).slice(0,k));
          }
        });
      };

      var delay=140;
      var step=function(){
        if(self.stage!=='survey'){
          // reached complete (or other) — stop
          self.autoTesting=false;
          self.adminLog='Auto-test complete. Submitted '+self.domainProjects.length+' projects / '+self.totalPhaseCount+' phases. Code='+self.completionCode+' state='+self.submitState;
          return;
        }
        fillPhase();
        self.adminLog='Project '+(self.projectIndex+1)+'/'+self.domainProjects.length+' · Phase '+(self.phaseIndex+1)+'/'+self.phases.length+' filled';
        // jump to last question, then advance (advancePhase moves phase/project or submits)
        self.qIndex = self.questions.length-1;
        setTimeout(function(){ self.advancePhase(); setTimeout(step, delay); }, delay);
      };
      setTimeout(step, delay);
    }
  },
  mounted(){ this.captureUrlParams(); }
});

</script>
</body>
</html>
